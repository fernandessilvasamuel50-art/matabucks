{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "outputDirectory": "dist",
  "regions": ["iad1"],
  "rewrites": [{"source":"/api/auth/:action*","destination":"/api/auth?route=:action*"}],
  "functions": {
    "api/tracker.js": {"includeFiles": "data/baseline.json"},
    "api/events.js": {"includeFiles": "data/baseline.json"}
  }
}
